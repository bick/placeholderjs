{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placeholderjs",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
